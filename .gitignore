# Publication allowlist for the Apple port and preserved shared/reference sources.
# Local files, build outputs, research notes and new top-level folders stay private.
/*
!/.gitignore
!/.gitattributes
!/.gitmodules
!/readme.md
!/LICENSE
!/THIRD_PARTY_NOTICES.md
!/requirements.txt
!/dependencies.json
!/dependencies-audio.json
!/dependencies-dxvk.json
!/dependencies-host.json
!/dependencies-turnip.json
!/dependencies-textures.json
!/dependencies-vkd3d.json
!/CMakeLists.txt
!/BUILDING.md
!/build_macos.sh
!/build_ios.sh

!/engine/
/engine/**
!/engine/**/
!/engine/**/*.c
!/engine/**/*.cpp
!/engine/**/*.h
!/engine/**/*.inc
!/engine/**/*.json
!/engine/**/*.uc
!/engine/**/*.ini

!/platform/
/platform/*
!/platform/apple/
/platform/apple/*
!/platform/apple/*.c
!/platform/apple/*.cpp
!/platform/apple/*.m
!/platform/apple/*.mm
!/platform/apple/*.h
!/platform/apple/Info.plist.in
!/platform/apple/ios/
!/platform/apple/ios/*.m
!/platform/apple/ios/*.mm
!/platform/apple/ios/*.h
!/platform/apple/ios/*.inc
!/platform/apple/ios/CMakeLists.txt
!/platform/apple/ios/Info.plist.in
!/platform/apple/ios/probe/
!/platform/apple/ios/probe/CMakeLists.txt
!/platform/apple/ios/probe/Info.plist
!/platform/apple/ios/probe/*.m

!/icons/
/icons/*
!/icons/AppIcon1024.png

!/docs/
/docs/*
!/docs/apple/
/docs/apple/*
!/docs/apple/*.md

!/config/
/config/*
!/config/inputs.json
!/config/modules.json
!/config/apple-dependencies.json
!/config/warm-functions.txt

!/tools/
/tools/*
!/tools/*.py
!/tools/function_coverage_runtime.c
!/tools/function_coverage_runtime.h

!/tests/
/tests/*
!/tests/*.c
!/tests/*.h
!/tests/*.cpp
!/tests/*.m
!/tests/*.mm
!/tests/*.inc
!/tests/*.hlsl
!/tests/*.py
!/tests/uscript/
!/tests/uscript/AndroidPortChecks/
!/tests/uscript/AndroidPortChecks/Classes/
!/tests/uscript/AndroidPortChecks/Classes/*.uc

!/reference/
/reference/*
!/reference/dlmalloc/
!/reference/mojoshader/
!/reference/pcrecomp/
!/reference/homm5/
!/reference/adrenotools/
!/reference/turnip-android/
!/reference/audio-runtime/
!/reference/dxvk-runtime/
!/reference/dxvk/
!/reference/astcenc/
!/reference/etcpak/
!/reference/vkd3d/
/reference/dxvk/**
!/reference/dxvk/**/
!/reference/dxvk/LICENSE
!/reference/dxvk/include/native/**
!/reference/dxvk/include/vulkan/LICENSE.md
!/reference/dxvk/include/vulkan/include/vulkan/*.h
!/reference/dxvk/include/vulkan/include/vk_video/*.h

# Defense in depth for outputs, credentials and machine settings in source trees.
**/__pycache__/
**/build/
**/.gradle/
**/.idea/
**/.vscode/
*.py[cod]
*.apk
*.aab
*.exe
*.dll
*.so
*.o
*.obj
*.a
*.class
*.dex
*.zip
*.7z
*.tar.gz
*.log
*.keystore
*.jks
*.pem
*.key
.env
.env.*
**/cdkey.txt
local.properties
STATE.md
AGENTS.md

# The pinned prebuilt runtimes the APK packages (hash-pinned in dependencies-*.json).
!/reference/audio-runtime/arm64-v8a/*.so
!/reference/dxvk-runtime/*.so
!/reference/turnip-android/*.so

!/reference/fsr1/
!/reference/fsr1/ffx_fsr1.h
!/reference/fsr1/FSR1-MIT.txt
